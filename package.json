{
  "name": "claude-superagent",
  "version": "0.0.0",
  "private": true,
  "description": "Unofficial: DeepSeek's dsh-superagent design, rebuilt on Claude Code (Agent SDK). One always-on router, one worker per ticket, follow-ups go straight to the worker.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "start": "node --experimental-transform-types --no-warnings src/cli.ts start"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@anthropic-ai/sdk": "0.135.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "proper-lockfile": "4.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "bin": {
    "claude-superagent": "bin/claude-superagent.mjs"
  }
}
