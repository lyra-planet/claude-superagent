{
  "name": "claude-superagent",
  "version": "0.0.0",
  "private": true,
  "description": "Unofficial: DeepSeek's dsh-superagent design, rebuilt on Claude Code (Agent SDK). One always-on router, one worker per ticket, follow-ups go straight to the worker.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node --experimental-transform-types --no-warnings src/cli.ts start",
    "build:panel": "esbuild panel=src/client/main.tsx panel=src/client/panel.css index=src/client/index.html --bundle --minify --format=esm --target=es2022 --loader:.html=copy --outdir=lib/panel --log-level=warning",
    "build:tui": "esbuild tui=src/tui/main.tsx --bundle --platform=node --format=esm --target=node22 --packages=external --jsx=automatic --out-extension:.js=.mjs --outdir=lib --log-level=warning",
    "build": "npm run build:panel && npm run build:tui",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@anthropic-ai/sdk": "0.135.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ink": "5.2.1",
    "proper-lockfile": "4.1.2",
    "react": "18.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "ink-testing-library": "4.0.0",
    "jsdom": "29.1.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "bin": {
    "claude-superagent": "bin/claude-superagent.mjs"
  }
}
